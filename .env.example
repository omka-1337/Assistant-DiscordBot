# Put each comment on its own line. A comment after a value becomes part of
# that value when systemd reads this file on the server.

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_token_here

# Provider used until a server picks its own in /setup: deepseek or gemini
# Gemini free tier is capped at 20 requests per minute per model
AI_PROVIDER=deepseek

# Keys of the providers you want selectable in /setup; at least one is required
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Model overrides, empty means the provider default
# deepseek -> deepseek-chat, gemini -> gemini-3.5-flash
# gemini-3.8-flash is faster but its free quota is only 20 requests
DEEPSEEK_MODEL=
GEMINI_MODEL=

# Language used until a server picks its own in /setup: uk or en
BOT_LANGUAGE=uk

# How many recent messages of the linked channel are pulled as context
CONTEXT_LIMIT=100

# Test guild ID for instant slash command sync (optional, development only)
GUILD_ID=

# Locally, keep this file readable only by you: chmod 600 .env
# On a server it lives at /etc/assistant-bot/env, owned by root, mode 600
